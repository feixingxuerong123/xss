        "high"
      ],
      [
        "\\bref\\s*\\(\\s*(?:null|[\"\\'])\\s*\\)\\s*;?\\s*\\w+\\.\\s*value\\s*(?:\\.\\s*innerHTML\\s*=|\\.innerHTML)",
