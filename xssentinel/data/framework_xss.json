{
  "_meta": {
    "note": "Framework XSS detection rules (React/Vue/AngularJS/Svelte/Lit). Moved out of framework_xss.py (~320 lines of literal tuples); that module re-compiles the regexes at import. Edit this JSON to add or adjust rules.",
    "schema": {
      "framework_raw_patterns": "framework -> [[regex, pattern_name, description], ...]",
      "framework_detectors": "[[regex, framework_name], ...] used by detect_framework()",
      "severity_rank": "severity -> rank"
    },
    "version": 1
  },
  "framework_raw_patterns": {
    "react": [
      [
        "dangerouslySetInnerHTML\\s*=\\s*\\{\\s*\\{\\s*__html\\s*:",
        "React dangerouslySetInnerHTML renders raw HTML without escaping",
        "high"
      ],
      [
        "__html\\s*:\\s*[^,}\\s]+",
        "React __html property receives raw HTML",
        "high"
      ],
      [
        "href\\s*=\\s*\\{[^}]*(?:props|state|input|user|data|param|item|val|content|text|msg|raw|html)\\w*[^}]*\\}",
        "React href bound to dynamic value (potential javascript: URL)",
        "medium"
      ],
      [
        "\\beval\\s*\\(",
        "React component calls eval() on dynamic value",
        "low"
      ],
      [
        "new\\s+Function\\s*\\(",
        "React component calls new Function()",
        "low"
      ],
      [
        "setTimeout\\s*\\(\\s*['\\\"`]",
        "React setTimeout with string argument (eval-like)",
        "low"
      ],
      [
        "setInterval\\s*\\(\\s*['\\\"`]",
        "React setInterval with string argument (eval-like)",
        "low"
      ],
      [
        "href\\s*=\\s*\\{[`\\'\"]\\s*javascript:",
        "React href bound to a javascript: URL literal",
        "high"
      ],
      [
        "\\.innerHTML\\s*=",
        "React ref .innerHTML assignment (imperative sink)",
        "medium"
      ],
      [
        "dangerouslySetInnerHTML",
        "React dangerouslySetInnerHTML usage (review for sanitization)",
        "medium"
      ]
    ],
    "vue": [
      [
        "v-html\\s*=\\s*[\"\\'][^\"\\']+[\"\\']",
        "Vue v-html directive renders raw HTML",
        "high"
      ],
      [
        "v-html",
        "Vue v-html directive present (review for sanitization)",
        "medium"
      ],
      [
        ":href\\s*=\\s*[\"\\'][^\"\\']*(?:props|data|input|user|param|item|val|content|text|msg|raw|html)\\w*[^\"\\']*[\"\\']",
        "Vue :href bound to dynamic value (potential javascript: URL)",
        "medium"
      ],
      [
        ":href\\s*=\\s*[\"\\']\\s*javascript:",
        "Vue :href bound to javascript: URL literal",
