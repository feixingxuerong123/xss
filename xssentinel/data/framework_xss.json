        "low"
      ],
      [
        "this\\.\\$\\.\\w+\\.innerHTML\\s*=",
        "Polymer this.$.element.innerHTML assignment (raw HTML sink)",
        "high"
      ],
      [
        "\\beval\\s*\\(",
        "Lit/Polymer component calls eval()",
        "low"
      ],
      [
        "new\\s+Function\\s*\\(",
        "Lit/Polymer component calls new Function()",
