        "high"
      ],
      [
        "\\{@html\\s+[^}]+\\}",
        "Svelte {@html} tag renders raw HTML",
        "high"
      ],
      [
        "\\{@html",
        "Svelte {@html} tag present (review for sanitization)",
        "medium"
      ],
      [
        "href\\s*=\\s*\\{[^}]*(?:props|state|input|user|data|param|item|val|content|text|msg|raw|html)\\w*[^}]*\\}",
        "Svelte href bound to dynamic value (potential javascript: URL)",
        "medium"
      ],
      [
        "href\\s*=\\s*\\{[`\\'\"]\\s*javascript:",
        "Svelte href bound to javascript: URL literal",
        "high"
      ],
      [
        "on:\\w+\\s*=\\s*[\"\\'][^\"\\']*(?:eval|Function|innerHTML|document\\.write|setTimeout|setInterval)\\b",
        "Svelte event handler invokes a dangerous sink",
        "medium"
      ],
      [
        "use:\\w+",
        "Svelte use:action directive (review for arbitrary code execution)",
        "low"
      ],
      [
        "\\beval\\s*\\(",
        "Svelte component calls eval()",
        "low"
      ],
      [
        "new\\s+Function\\s*\\(",
        "Svelte component calls new Function()",
        "low"
      ],
      [
        "<svelte:component\\s+this\\s*=\\s*\\{[^}]+\\}",
        "Svelte dynamic component instantiation (review)",
        "low"
      ],
      [
        "export\\s+function\\s+load\\s*\\([^)]*\\)\\s*\\{[\\s\\S]*?@html",
