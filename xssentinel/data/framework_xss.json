  },
  "framework_detectors": [
    [
      "(?:data-reactroot|data-reactid|__reactInternalInstance|_reactRootContainer|reactDOM|ReactDOM\\.render|react-dom|react\\.development|react\\.production|dangerouslySetInnerHTML)",
      "react"
    ],
    [
      "(?:data-v-[a-f0-9]{8}|v-if|v-for|v-html|v-show|v-model|v-bind|vue\\.runtime|vue\\.min\\.js|vue@2|vue@3|new\\s+Vue\\s*\\(|createApp\\s*\\(|__vue__|__vue_app__)",
      "vue"
    ],
    [
      "(?:_ngcontent-[a-z0-9]+|_nghost-[a-z0-9]+|ng-version|ng-app|ng-controller|ng-bind|ng-model|ng-init|\\[innerHTML\\]|\\[ngClass\\]|\\[ngStyle\\]|platformBrowserDynamic|@angular/core|angular\\.min\\.js|ng-reflect-)",
      "angular"
    ],
    [
      "(?:class=\"svelte-[a-z0-9]+|svelte-1|__svelte|svelte\\.\\w+\\.js|svelte\\.\\w+\\.mjs|svelte/internal|svelte.kit|@html\\})",
      "svelte"
    ],
    [
      "(?:LitElement|lit-html|lit-element|unsafeHTML|unsafeSVG|polymer|dom-module|customElements\\.define|@polymer|webcomponents\\.js|ShadyCSS|ShadyDOM)",
      "lit"
    ]
  ],
  "severity_rank": {
    "high": 3,
    "medium": 2,
    "low": 1
  }
}