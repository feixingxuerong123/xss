      ],
      [
        "bypassSecurityTrustScript\\s*\\(",
        "Angular bypassSecurityTrustScript() disables script sanitization",
        "high"
      ],
      [
        "bypassSecurityTrustUrl\\s*\\(",
        "Angular bypassSecurityTrustUrl() disables URL sanitization",
        "high"
      ],
      [
        "bypassSecurityTrustResourceUrl\\s*\\(",
        "Angular bypassSecurityTrustResourceUrl() disables resource URL sanitization",
        "high"
      ],
      [
        "bypassSecurityTrustStyle\\s*\\(",
        "Angular bypassSecurityTrustStyle() disables style sanitization",
        "high"
      ],
      [
        "DomSanitizer",
        "Angular DomSanitizer import (review for bypass methods)",
        "medium"
      ],
      [
        "\\[href\\]\\s*=\\s*[\"\\'][^\"\\']+[\"\\']",
        "Angular [href] property binding (potential javascript: URL)",
        "medium"
      ],
      [
        "\\[(?:src|url|action|formaction|data)\\]\\s*=\\s*[\"\\'][^\"\\']+[\"\\']",
        "Angular attribute binding for dangerous attribute (src/url/action/data)",
        "medium"
      ],
      [
        "\\[attr\\.on\\w+\\]\\s*=",
        "Angular [attr.on*] attribute binding to event handler",
        "high"
      ],
      [
        "\\beval\\s*\\(",
        "Angular component calls eval()",
        "low"
      ],
      [
        "new\\s+Function\\s*\\(",
        "Angular component calls new Function()",
        "low"
      ],
      [
        "\\[style\\]\\s*=\\s*[\"\\'][^\"\\']+[\"\\']",
        "Angular [style] binding (potential CSS injection)",
        "medium"
      ],
      [
        "\\[style\\.\\w+\\]\\s*=\\s*[\"\\'][^\"\\']+[\"\\']",
        "Angular [style.*] sub-property binding (CSS injection risk)",
        "medium"
      ],
      [
        "\\[class\\]\\s*=\\s*[\"\\'][^\"\\']+[\"\\']",
        "Angular [class] binding (review for class injection)",
        "low"
      ],
      [
        "\\|\\s*(?:bypassSecurityTrustHtml|bypassSecurityTrustScript|bypassSecurityTrustUrl|bypassSecurityTrustResourceUrl|bypassSecurityTrustStyle)",
        "Angular template pipe invokes bypassSecurityTrust* method",
        "high"
      ],
      [
        "ng-bind-html\\s*=\\s*[\"\\'][^\"\\']+[\"\\']",
        "AngularJS ng-bind-html (review for $sce.trustAsHtml usage)",
        "medium"
      ],
      [
        "\\$sce\\.trustAsHtml\\s*\\(",
        "AngularJS $sce.trustAsHtml() disables sanitization",
        "high"
      ],
      [
        "\\[ngTemplateOutlet\\]\\s*=",
        "Angular [ngTemplateOutlet] dynamic template (review for injection)",
        "low"
      ],
      [
        "\\[routerLink\\]\\s*=\\s*[\"\\'][^\"\\']*(?:props|input|user|param|data)\\w*[^\"\\']*[\"\\']",
        "Angular [routerLink] bound to dynamic value",
        "medium"
      ]
    ],
    "svelte": [
      [
        "\\{@html\\s+\\$\\w+",
        "Svelte {@html} with reactive $store value (raw HTML from store)",
        "high"
      ],
      [
        "\\{@html\\s+JSON\\.stringify",
