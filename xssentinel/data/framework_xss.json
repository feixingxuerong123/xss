    "lit": [
      [
        "\\bunsafeHTML\\s*\\(",
        "Lit unsafeHTML() directive renders raw HTML without sanitization",
        "high"
      ],
      [
        "\\bunsafeSVG\\s*\\(",
        "Lit unsafeSVG() directive renders raw SVG (script execution risk)",
        "high"
      ],
      [
        "\\bhtml\\s*`[^`]*\\$\\{[^}]*(?:user|input|data|param|item|val|content|text|msg|raw|html|props|query)\\w*[^}]*\\}[^`]*`",
        "Lit html`` template with user-controlled interpolation (review context)",
        "medium"
      ],
      [
        "\\brender\\s*\\(\\s*html\\s*`",
        "Lit render() function with html`` template (review for unsafeHTML)",
        "low"
      ],
      [
        "(?:LitElement|LitElementMixin|customElements\\.define)\\b",
        "Lit custom element definition (review for unsafeHTML usage)",
        "low"
      ],
      [
        "(?:attached|ready|connectedCallback)\\s*\\([^)]*\\)\\s*\\{[^}]*\\.innerHTML\\s*=",
        "Polymer lifecycle callback writes to innerHTML",
        "high"
      ],
      [
        "<dom-module\\s+id\\s*=\\s*[\"\\'][^\"\\']+[\"\\']",
