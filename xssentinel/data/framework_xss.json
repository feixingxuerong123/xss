        "high"
      ],
      [
        "\\bcreateApp\\s*\\(",
        "Vue 3 createApp() detected (review for v-html / ref+innerHTML sinks)",
        "low"
      ],
      [
        "<script\\s+setup[^>]*>[\\s\\S]*?v-html",
        "Vue 3 <script setup> SFC with v-html directive",
        "high"
      ],
      [
        "(?:watchEffect|watch)\\s*\\(\\s*\\(\\s*\\)\\s*=>\\s*\\{[^}]*\\.innerHTML\\s*=",
        "Vue 3 watch/watchEffect callback writes to innerHTML",
        "high"
      ],
      [
        "\\beval\\s*\\(",
        "Vue component calls eval()",
        "low"
      ],
      [
        "new\\s+Function\\s*\\(",
        "Vue component calls new Function()",
        "low"
      ]
    ],
    "angular": [
      [
        "\\[innerHTML\\]\\s*=\\s*[\"\\'][^\"\\']+[\"\\']",
