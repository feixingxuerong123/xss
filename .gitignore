# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# 测试 / 覆盖率
.pytest_cache/
.coverage
htmlcov/

# 运行生成物
*.log
report.html
report.html.json
# Phase 176: LLM 池冷却状态（运行期生成；删掉即重置全部冷却）
xssentinel/data/llm_state.json
.benchmarks/

# 备份文件（git 即历史，.bak 不再需要入库）
*.bak
*.bak-*
*-原版.md

# 本地 AI 工具状态（非项目代码）
.qoder/
.trae/
.agenthub/

# 根目录一次性探针 / 诊断 / 审计脚本及其输出目录。
# 注意：这些此前只写在 .git/info/exclude（不入库、换机即失效），
# 现迁入共享 .gitignore。_q_*.py 是并行智能体的在制品，只忽略、不删除。
/_*.py
/_*.log
/_*.har
/_*.json
/_*.html
/_*_out/
/_audit_backup/

# tests 目录下的演示/扫描输出
*_report.html
*_report.json
*_report.csv
*_report.sarif
tests/cli_csv.csv
tests/cli_sarif.sarif
tests/batch_reports/

# benchmark 运行临时文件
benchmark/results/tmp*.json
.coverage*
.coverage_report.txt

# benchmark runs can drop per-target JSON reports in benchmark/
benchmark/http_*.json

# 回归批次 runner 的逐文件日志（失败/重试才写，证据保留用）
benchmark/results/regression_logs/

# 根目录一次性草稿约定:_ 前缀 = 探针/日志/产物,不入库。
# 历史草稿已归档到 dev/attic/(同样不入库)。
/_*
/dev/attic/*
!/dev/attic/README.md

# LLM provider config carries API keys -- template is tracked instead
xssentinel/data/llm_providers.json

# dev/ 沿用根目录约定:_ 前缀 = 探针/日志/产物,不入库。
# (已追踪的 dev/_r4_construct_probe.py 等不受影响;CI 仍可引用。)
/dev/_*

# 跑分产物里的机器相关/证据日志,不入库(历史追踪文件不受影响)
benchmark/results/*_log.txt
benchmark/results/INVALID_*

# 本地 AI 工具状态(此前只写在 .git/info/exclude,换机即失效,现共享化)
.workbuddy/
