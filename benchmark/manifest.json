{
  "_meta": {
    "name": "XSSentinel Accuracy Benchmark",
    "version": "1.0",
    "description": "Independent positive/negative corpus for measuring detection accuracy (recall, precision, FPR). Each case defines a server reflection environment; the scanner generates its own payloads.",
    "ground_truth_values": [
      "vulnerable",
      "safe"
    ],
    "difficulty_values": [
      "easy",
      "medium",
      "hard"
    ],
    "fields": {
      "id": "unique case identifier",
      "path": "server endpoint path",
      "param": "query parameter name (empty string for DOM-only cases)",
      "mode": "server reflection behavior (maps to server.py handler)",
      "ground_truth": "vulnerable = should detect, safe = should NOT detect",
      "context": "reflection context category",
      "difficulty": "how hard to detect correctly",
      "source": "knowledge source (PATT=PayloadsAllTheThings, CVE, OWASP, etc.)",
      "note": "brief description"
    }
  },
